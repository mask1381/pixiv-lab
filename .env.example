# ── Pixiv ────────────────────────────────────────────────────────────────
# The pixiv app's public client id/secret (same for everyone — not a secret).
# The REFRESH TOKEN is your own secret: it is this machine's access to pixiv.
PIXIV_REFRESH_TOKEN=
PIXIV_CLIENT_ID=MOBrBDS8blbauoSck0ZfDbtuzpyT
PIXIV_CLIENT_SECRET=lsACyCD94FhDUtGTXi3QzcFE2uU1hqtDaKeqrdwj

# ── Telegram ──────────────────────────────────────────────────────────────
# Bot token used only to *read* media refs for caption planning. Optional.
TELEGRAM_BOT_TOKEN=

# ── Userbot (Telethon) ────────────────────────────────────────────────────
# The machine posts through a userbot session. These are machine secrets.
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# ── Batch & storage channel ───────────────────────────────────────────────
# The private group where the bot drops batch JSON files and reads /ack.
BATCH_CHAT_ID=
# The channel where the machine uploads zips/galleries and the storage bot
# replies with deep links. Per-channel values arrive in the batch; the .env
# values are only a local fallback for manual runs. Nothing here is a secret
# you must guard beyond not leaking your own channel ids publicly.
STORAGE_CHAT_ID=
STORAGE_BOT_USERNAME=
STORAGE_BOT_LINK_LABEL=

# ── Optional ──────────────────────────────────────────────────────────────
DRY_RUN=false
